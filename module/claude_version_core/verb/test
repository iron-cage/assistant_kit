#!/usr/bin/env bash
# test — run the module test suite inside the runbox container.
# The engine is the globally-installed `runbox` (shipped by family_dev); it
# discovers the workspace's owning config (runbox/runbox.yml) by walking up
# from this module directory, and runs this module's l1 as the payload.
set -euo pipefail
MODULE_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )/.." && pwd )"
if [[ -n "${VERB_LAYER:-}" ]]; then
  echo "ERROR: VERB_LAYER is not valid on the host side." >&2
  echo "Standard invocation: cd module/claude_version_core && ./verb/test" >&2
  exit 1
fi
if [[ "${1:-}" == "--dry-run" ]]; then echo "runbox .live -- ./module/claude_version_core/verb/test.d/l1"; exit 0; fi
cd "$MODULE_DIR" && exec runbox .live -- "./module/claude_version_core/verb/test.d/l1"
