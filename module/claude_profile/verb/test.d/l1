#!/usr/bin/env bash
# l1 — bare test execution (VERB_LAYER=l1); module-scoped full gate, in-container.
# Invoked as the runbox .live payload; delegates to `will .test` at level::3 by
# default (nextest + doc tests + clippy); cwd-scoping (this module directory) is
# what limits cargo to this package — no -p flags needed. will is the
# plugin-mounted ELF at /usr/local/bin/will (see runbox/runbox.yml).
set -euo pipefail
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
cd "$SCRIPT_DIR/../.."
DRY_RUN=0
if [[ "${1:-}" == "--dry-run" ]]; then DRY_RUN=1; shift; fi
# Fix(BUG-1588): emit a wrapper default only when the caller has not already supplied
# that key.
# Root cause: unilang collects a repeated named parameter into a single Value::List, and
# will_test's accessors matched only the scalar kind each expected — so `will .test
# level::1 level::2` ran at the default level 3, exit 0, no diagnostic. Hardcoding
# `level::3 show_build::1` ahead of "$@" therefore turned every caller-supplied
# level::/show_build:: into a silent no-op.
# Pitfall: upstream (yrd_core/family_will/will, BUG-1588) now rejects a duplicate by name
# instead of defaulting, so on a current will the same collision hard-fails rather than
# misbehaving quietly. The guard is what keeps a caller override working at all, and is
# still required against older deployed builds that predate that fix. Any future
# hardcoded default must be added to this guard list, not to the exec line — appending it
# there reintroduces the collision for that key alone.
WILL_ARGS=()
for kv in level::3 show_build::1; do
  key="${kv%%::*}"
  for a in "$@"; do
    [[ "$a" == "$key::"* ]] && continue 2
    # unilang folds an alias into the same argument vector as its canonical name, so
    # `level::3 l::1` collides exactly as `level::3 level::1` does. Guarding the canonical
    # name alone still emits a duplicate for a caller who used the short form.
    [[ "$key" == "level" && "$a" == "l::"* ]] && continue 2
  done
  WILL_ARGS+=( "$kv" )
done
WILL_ARGS+=( "$@" )
if (( DRY_RUN )); then echo "will .test ${WILL_ARGS[*]} (module-scoped)"; exit 0; fi
# Cargo deps resolve from the engine-owned runbox_cargo_home volume at /cargo
# (runbox TSK-1446), warmed by the engine's probe/fetch flow — keyed on the
# yml's own CARGO_NET_OFFLINE declaration. The container deliberately keeps
# network access (runbox.yml network.live: default, task 1460): lim_it
# live-API tests reach the real API via the mounted ~/.claude token. This
# export is belt-and-braces with the yml declaration — cargo stays hermetic
# either way.
export CARGO_NET_OFFLINE=true
# Fix(issue-nextest-pty-output): Disable nextest's interactive PTY progress bar.
# Root cause: wrun_core spawns subprocesses via PTY, causing nextest to detect isatty()=true
# and activate indicatif's cursor-movement progress display. wrun_core's ANSI normalization
# (consolidate_carriage_returns + extract_ansi_erase_codes) then discards this output,
# making all test results invisible (exit 0, zero per-test lines visible).
# With NO_COLOR=1, indicatif returns hidden()=true regardless of isatty(), and nextest
# falls back to plain \n-terminated output that survives wrun_core's normalization intact.
# Pitfall: environment inheritance carries the fix into the nextest that will spawns —
# it holds regardless of the mounted will binary's version.
export NO_COLOR=1
# Container signal for the container-only test invariant (nextest setup script + Rust guards).
export RUNBOX_CONTAINER=1
# Fix(issue-will-delegation-in-container): keep will's verb-first delegation off in-container.
# Root cause: any multi-crate scope (scope::subtree, scope::workspace) makes will enqueue one
# `env W3_TEST_DELEGATED=1 ./verb/test` job per member crate. Those are the HOST-side entries,
# which exec `runbox` — absent inside the container this payload already runs in — so every
# delegated job dies with `exec: runbox: not found` (exit 1) before a single test runs. The
# container IS the environment those verbs would construct, so the direct pipeline is the
# correct semantic here; W3_TEST_DELEGATE=0 is will's documented kill switch for exactly this
# wrapping-script case (will_test verb_delegation.rs, Environment Contract).
# Pitfall: a single-crate scope never delegates, so the default `verb test` path masks this
# completely — it only surfaces once a scope:: that spans crates actually reaches will. The
# workspace payload (verb/test.d/l1) has always set this; the module payloads did not.
export W3_TEST_DELEGATE=0
# level::3 runs nextest + doc tests + clippy, all warnings-as-errors — will owns the
# RUSTFLAGS policy, so no export here. show_build::1 pins full per-job streaming:
# will's current default (show_build::0, quiet_on_success) prints nothing at all on a
# clean pass, which reads as a broken gate. Both are defaults a caller may override.
exec will .test "${WILL_ARGS[@]}"
