#!/usr/bin/env bash
# l1 — targeted nextest execution (VERB_LAYER=l1); runs a single NEXTEST_FILTER.
#
# Invoked in-container as the .live payload of verb/test_only (workspace launcher).
# Does NOT use w3; runs cargo nextest directly so the filter is applied without
# the full-suite overhead.  Uses the engine-provided working volume (CARGO_TARGET_DIR) for
# fast incremental compilation.
set -euo pipefail
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
cd "$SCRIPT_DIR/../.."
if [[ -z "${NEXTEST_FILTER:-}" ]]; then
  echo "ERROR: NEXTEST_FILTER is not set — invoke via ./verb/test_only <filter> on the host." >&2
  exit 1
fi
if [[ "${1:-}" == "--dry-run" ]]; then
  echo "RUSTFLAGS=\"-D warnings\" cargo nextest run --all-features \"$NEXTEST_FILTER\""
  exit 0
fi
# Prevent cargo from updating the registry index (deps are pre-cooked in the image).
export CARGO_NET_OFFLINE=true
# Disable nextest PTY progress bar (same reason as test.d/l1 — wrun_core PTY isatty).
export NO_COLOR=1
export RUNBOX_CONTAINER=1
export RUSTFLAGS="-D warnings"
# CARGO_TARGET_DIR is exported by the engine (persistent working volume) — it
# overrides the host .cargo/config.toml target-dir redirect inside the container.
exec cargo nextest run --all-features "$NEXTEST_FILTER"
