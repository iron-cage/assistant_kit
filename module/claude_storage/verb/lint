#!/usr/bin/env bash
# lint — run clippy for this module inside the runbox container.
# The engine is the globally-installed `runbox` (shipped by family_dev); it
# discovers the workspace's owning config (runbox/runbox.yml) by walking up
# from this module directory, and runs this module's l1 as the payload.
#
# Clippy is a compilation, not a read: running it on the host writes to the
# host Cargo cache and links against host native libraries, which is exactly
# what `rulebook.md § Test Execution : Container-Only Testing` forbids.
set -euo pipefail
MODULE_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )/.." && pwd )"
if [[ -v VERB_LAYER ]]; then
  echo "ERROR: VERB_LAYER is not valid on the host side." >&2
  echo "Standard invocation: cd module/claude_storage && ./verb/lint" >&2
  exit 1
fi
if [[ "${1:-}" == "--dry-run" ]]; then echo "runbox .live -- ./module/claude_storage/verb/lint.d/l1"; exit 0; fi
cd "$MODULE_DIR" && exec runbox .live -- "./module/claude_storage/verb/lint.d/l1"
