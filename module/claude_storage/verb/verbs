#!/usr/bin/env bash
# do verbs — list available verbs for this project (protocol meta-verb)
set -euo pipefail
printf '%-13s %-11s %s\n' build   available "cargo build -p claude_storage"
printf '%-13s %-11s %s\n' test    available "runbox .live (container, module-scoped)"
printf '%-13s %-11s %s\n' clean   available "cargo clean -p claude_storage"
printf '%-13s %-11s %s\n' run     available "cargo run -p claude_storage --bin clg"
printf '%-13s %-11s %s\n' lint    available "runbox .live (container, module-scoped clippy)"
printf '%-13s %-11s %s\n' verify   available   "will .test level::4"
printf '%-13s %-11s %s\n' install  available  "cargo install --path ."
printf '%-13s %-11s %s\n' verbs   built-in  "-"
printf '%-13s %-11s %s\n' package_info built-in  "-"
