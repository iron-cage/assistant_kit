#!/usr/bin/env bash
# l1 — targeted nextest execution; runs a single nextest filter expression inside the container.
# Entered in-container as the .live payload of verb/test_only (workspace launcher)
# when NEXTEST_FILTER is set.
# No level-3 overhead (no clippy, no doc tests) — nextest only.
set -euo pipefail
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
cd "$SCRIPT_DIR/../.."
if [[ -z "${NEXTEST_FILTER:-}" ]]; then
  echo "ERROR: NEXTEST_FILTER is not set — invoke via ./verb/test_only <filter> on the host." >&2
  exit 1
fi
# Prevent cargo from updating the registry index (deps are pre-cooked in the image).
export CARGO_NET_OFFLINE=true
# Disable nextest PTY progress bar (same reason as test.d/l1 — PTY isatty detection).
export NO_COLOR=1
export RUSTFLAGS="-D warnings"
# CARGO_TARGET_DIR is exported by the engine (persistent working volume) — it
# overrides the host .cargo/config.toml target-dir redirect inside the container.
exec cargo nextest run --all-features --no-fail-fast "$NEXTEST_FILTER"
