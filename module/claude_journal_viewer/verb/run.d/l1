#!/usr/bin/env bash
# l1 — run clj binary directly (cargo ecosystem).
set -euo pipefail
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
cd "$SCRIPT_DIR/../.."
if [[ "${1:-}" == "--dry-run" ]]; then shift; echo "cargo run -p claude_journal_viewer --bin clj --${*:+ $*}"; exit 0; fi
exec cargo run -p claude_journal_viewer --bin clj -- "$@"
