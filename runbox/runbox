#!/usr/bin/env bash
# runbox — launcher for the current shared engine (family_dev/default).
# Preserves the caller's CWD: the engine walks up from $PWD to the nearest
# runbox.yml (module configs are consumers; this directory's runbox.yml is the
# owning config), so callers cd to their crate directory before exec'ing this.
set -euo pipefail
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
ENGINE="$SCRIPT_DIR/../../../family_dev/default/module/runbox/sh/runbox"
if [[ ! -x "$ENGINE" ]]; then
  echo "error: current runbox engine not found at $ENGINE" >&2
  echo "  expected the family_dev/default checkout as a sibling under yrd_core/" >&2
  exit 1
fi
exec "$ENGINE" "$@"
