#!/usr/bin/env bash
# l1 — bare test execution (VERB_LAYER=l1); full workspace gate, in-container.
# The config script for runbox .run/.live — delegates to `will .test` at level::3
# by default (nextest + doc tests + clippy) across every workspace member; cwd at the
# workspace root is what sets the scope. will is the plugin-mounted ELF at
# /usr/local/bin/will (see runbox/runbox.yml).
set -euo pipefail
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
cd "$SCRIPT_DIR/../.."
DRY_RUN=0
if [[ "${1:-}" == "--dry-run" ]]; then DRY_RUN=1; shift; fi
# Fix(BUG-1588): emit a wrapper default only when the caller has not already supplied
# that key.
# Root cause: unilang collects a repeated named parameter into a single Value::List, and
# will_test's accessors matched only the scalar kind each expected — so `will .test
# level::1 level::2` ran at the default level 3, exit 0, no diagnostic. Hardcoding
# `level::3 show_build::1` ahead of "$@" therefore turned every caller-supplied
# level::/show_build:: into a silent no-op.
# Pitfall: upstream (yrd_core/family_will/will, BUG-1588) now rejects a duplicate by name
# instead of defaulting, so on a current will the same collision hard-fails rather than
# misbehaving quietly. The guard is what keeps a caller override working at all, and is
# still required against older deployed builds that predate that fix. Any future
# hardcoded default must be added to this guard list, not to the exec line — appending it
# there reintroduces the collision for that key alone.
WILL_ARGS=()
for kv in level::3 show_build::1; do
  for a in "$@"; do [[ "$a" == "${kv%%::*}::"* ]] && continue 2; done
  WILL_ARGS+=( "$kv" )
done
WILL_ARGS+=( "$@" )
if (( DRY_RUN )); then echo "will .test ${WILL_ARGS[*]}"; exit 0; fi
# Registry is pre-fetched at bake time and mounted read-only — never hit the network.
export CARGO_NET_OFFLINE=true
# Fix(BUG-008): Disable nextest's interactive PTY progress bar.
# Root cause: when the test runner captures subprocess output via PTY, nextest detects
# isatty()=true and activates indicatif's cursor-movement progress display. The output
# capture layer discards these ANSI control sequences, making all test results invisible
# (exit 0, zero per-test lines visible).
# With NO_COLOR=1, nextest uses hidden()=true regardless of isatty(), and falls back
# to plain \n-terminated output that survives output capture intact.
# Pitfall: environment inheritance ensures this env var propagates to nested runners
# automatically — the fix applies regardless of test runner binary version.
export NO_COLOR=1
# Container signal for the container-only test invariant (nextest setup script + Rust guards).
export RUNBOX_CONTAINER=1
# In-container, will's verb-first delegation must stay off: delegated jobs invoke
# each member's host-side verb/test, which execs `runbox` — unavailable inside the
# container the workspace gate is already running in. The container IS the
# environment those verbs would construct, so the direct pipeline is the correct
# semantic here. W3_TEST_DELEGATE=0 is will's documented kill switch for exactly
# this wrapping-script case (will_test verb_delegation.rs, Environment Contract).
export W3_TEST_DELEGATE=0
# level::3 runs nextest + doc tests + clippy, all warnings-as-errors — will owns the
# RUSTFLAGS policy, so no export here. show_build::1 pins full per-job streaming:
# will's current default (show_build::0, quiet_on_success) prints nothing at all on a
# clean pass, which reads as a broken gate. Both are defaults a caller may override.
exec will .test "${WILL_ARGS[@]}"
