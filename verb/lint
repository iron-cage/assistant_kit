#!/usr/bin/env bash
# lint — static analysis across all workspace crates, inside the runbox container.
# The engine is the globally-installed `runbox` (shipped by family_dev); it
# discovers the owning config (runbox/runbox.yml) and runs verb/lint.d/l1 as
# the payload.
#
# Clippy is a compilation, not a read: running it on the host writes to the
# host Cargo cache and links against host native libraries, which is exactly
# what `rulebook.md § Test Execution : Container-Only Testing` forbids.
# Usage: ./verb/lint [clippy-arg...]  (forwarded to cargo clippy ahead of the
#   `-- -D warnings` separator.)
set -euo pipefail
ROOT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )/.." && pwd )"
if [[ -n "${VERB_LAYER:-}" ]]; then
  echo "ERROR: VERB_LAYER is not valid on the host side." >&2
  echo "Standard invocation: ./verb/lint" >&2
  exit 1
fi
if [[ "${1:-}" == "--dry-run" ]]; then shift; echo "runbox .live -- ./verb/lint.d/l1${*:+ $*}"; exit 0; fi
cd "$ROOT_DIR" && exec runbox .live -- "./verb/lint.d/l1" "$@"
