# .cargo/ is deliberately INCLUDED in the build context: the cook stage copies it
# (COPY --from=planner /workspace/.cargo) so config-driven settings resolve during
# dependency cooking. It carries no credentials and no target-dir redirect.

# Compiled artifacts — excluded to keep build context small.
# Docker will use target/ from the cook stage, not the host.
target/

# Hyphen-prefixed directories are temporary scratch space (investigations,
# experiments, notes). Never relevant to a container build.
-*/

# Git history is not needed inside the image.
.git/

# ~/.claude is bind-mounted at runtime by the runbox engine (mirror mount) — host
# credentials in any workspace-local .claude/ must never be baked into a container
# image.
.claude/

